# =============================================================================
# Prospect AI — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA coloque valores reais neste arquivo (.env.example) nem em código.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obrigatório para persistir leads)
# Crie um projeto em https://supabase.com, rode database/schema.sql no SQL
# Editor e copie as chaves em Project Settings > API.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada com acesso total. Usada SOMENTE no servidor (API routes).
# Nunca exponha esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# IA — Anthropic Claude (opcional, mas recomendado)
# Sem esta chave, o sistema usa geração heurística (baseada em regras) em vez
# de IA para análises e mensagens, deixando isso explícito na interface.
# Obtenha em https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------------------------------------------------------
# Busca de negócios — Google Places API (opcional)
# Necessária para a etapa "findBusinesses" retornar resultados reais.
# Sem esta chave, a busca externa fica marcada como "não configurada" e não
# retorna leads reais (a menos que ENABLE_DEMO_MODE esteja ativado).
# Ative "Places API (New)" em https://console.cloud.google.com
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Modo demonstração (opcional, apenas desenvolvimento)
# Quando "true" e GOOGLE_PLACES_API_KEY não estiver configurada, o agente usa
# um conjunto de negócios fictícios claramente marcados como demonstração,
# para permitir testar o restante do fluxo (score, análise, UI) sem custo.
# NUNCA ative isso em produção.
# -----------------------------------------------------------------------------
ENABLE_DEMO_MODE=false
