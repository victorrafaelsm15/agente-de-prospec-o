# =============================================================================
# Prospect AI — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA coloque valores reais neste arquivo (.env.example) nem em código.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obrigatório para persistir leads)
# Crie um projeto em https://supabase.com, rode database/schema.sql no SQL
# Editor e copie as chaves em Project Settings > API.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Em projetos novos o Supabase chama essa chave de "publishable key"
# (prefixo sb_publishable_...) em vez de "anon key" — é a mesma coisa,
# cole aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave privada com acesso total (ignora RLS). Usada SOMENTE no servidor
# (API routes). Nunca exponha esta chave no frontend. Em projetos novos o
# Supabase chama essa chave de "secret key" (prefixo sb_secret_...) em vez
# de "service_role key" — é a mesma coisa, cole aqui.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# IA — Anthropic Claude (opcional, mas recomendado)
# Sem esta chave, o sistema usa geração heurística (baseada em regras) em vez
# de IA para análises e mensagens, deixando isso explícito na interface.
# Obtenha em https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Só é necessário se a sua API key for de organização (não escopada a um
# workspace específico) — a Anthropic API recusa a chamada sem esse header
# nesse caso. Encontre em console.anthropic.com > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# Busca de negócios — Google Places API (opcional)
# Necessária para a etapa "findBusinesses" retornar resultados reais.
# Sem esta chave, a busca externa fica marcada como "não configurada" e não
# retorna leads reais (a menos que ENABLE_DEMO_MODE esteja ativado).
# Ative "Places API (New)" em https://console.cloud.google.com
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Modo demonstração (opcional, apenas desenvolvimento)
# Quando "true" e GOOGLE_PLACES_API_KEY não estiver configurada, o agente usa
# um conjunto de negócios fictícios claramente marcados como demonstração,
# para permitir testar o restante do fluxo (score, análise, UI) sem custo.
# NUNCA ative isso em produção.
# -----------------------------------------------------------------------------
ENABLE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (opcional — V3)
# Integração OFICIAL da Meta. Sem essas variáveis, o botão de WhatsApp abre
# o link wa.me para você enviar manualmente pelo seu WhatsApp, e o sistema
# apenas registra a interação — nunca simula um envio automático.
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# E-mail transacional (opcional — V3, ex.: Resend, Postmark, SES)
# Sem essas variáveis, o botão de e-mail abre seu cliente de e-mail via
# mailto: e o sistema apenas registra a interação.
# -----------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# -----------------------------------------------------------------------------
# Limite de chamadas de IA por minuto (proteção de custo/abuso). Padrão: 20.
# -----------------------------------------------------------------------------
AI_RATE_LIMIT_PER_MINUTE=20
